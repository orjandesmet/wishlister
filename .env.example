# Supabase project settings > API keys. Copy to .env.local for local development.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Or use the local Supabase from `vp run db:start` (see README, "Local Supabase").
# These are the CLI's fixed local keys, not secrets.
# If docker is running, you can get these values `vp run db:status`
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# SUPABASE_SECRET_KEY=sb_secret_xxx

# Enable this to use the DEMO logins
# VITE_DEMO=true

# Netlify functions' app emails (netlify dev): send them to the local Mailpit instead of Resend.
# MAILPIT_URL=http://127.0.0.1:54324
